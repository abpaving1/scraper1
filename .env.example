# Proxy (get from Webshare / Bright Data)
PROXY_HOST=proxy.example.com
PROXY_PORT=1234
PROXY_USERNAME=your_username
PROXY_PASSWORD=your_password
PROXY_SESSION_PREFIX=acca-scraper

# Redis
REDIS_URL=redis://localhost:6379/0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tippster

# Scrape settings
SCRAPE_HEADLESS=true
SCRAPE_JITTER_MIN_SECONDS=1.5
SCRAPE_JITTER_MAX_SECONDS=4.0

# FreeSuperTips
FREESUPERTIPS_BASE_URL=https://www.freesupertips.com/football-tips/
FREESUPERTIPS_SCRAPE_INTERVAL_HOURS=4

# SoccerVista
SOCCERVISTA_BASE_URL=https://www.soccervista.com/
SOCCERVISTA_SCRAPE_INTERVAL_HOURS=6

# BettingExpert
BETTINGEXPERT_BASE_URL=https://www.bettingexpert.com/tips/football
BETTINGEXPERT_SCRAPE_INTERVAL_HOURS=4

# Logging

LOG_LEVEL=INFO
